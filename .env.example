# Hyperliquid
HL_ACCOUNT_ADDRESS=0xYourMainWalletAddress
HL_AGENT_PRIVATE_KEY=0xAgentWalletPrivateKey   # API agent wallet, NOT the main wallet key
HL_TESTNET=false

# Reference feeds
LSE_API_KEY=lse_live_xxx

# Grafana Cloud — used by the `alloy` service (docker compose --profile grafana). Stack -> Prometheus/Loki "Details".
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-xx.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=123456
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=654321
GRAFANA_CLOUD_API_KEY=glc_xxx   # access-policy token with metrics:write + logs:write

# Dashboard
DASHBOARD_TOKEN=change-me
